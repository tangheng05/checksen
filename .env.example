TELOXIDE_TOKEN=
DATABASE_URL=postgres://checksen:checksen@127.0.0.1:5432/checksen
HASH_SECRET=
ANTHROPIC_API_KEY=
# Free-tier AI for reading screenshots, and for text checks when ANTHROPIC_API_KEY is empty. Google may train on and review what it is sent; /help says so.
GEMINI_API_KEY=
# Optional link reputation from Google Safe Browsing (the full link is sent to Google).
SAFE_BROWSING_API_KEY=
# Optional file scanning: a local ClamAV daemon (socket path or host:port), and VirusTotal lookups by file hash only.
CLAMD_ADDRESS=
VIRUSTOTAL_API_KEY=
# Optional local Bot API server (--local mode) on the same machine, for checking files up to 50 MB instead of 20 MB.
TELEGRAM_API_URL=
